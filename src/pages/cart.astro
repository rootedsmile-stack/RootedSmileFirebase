---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Your Cart | Rooted Smile">
  <main style="max-width:750px;margin:0 auto;padding:24px 16px;">
    <h1>Your cart</h1>
    <div id="cart-area">
      <p>Loading your cart…</p>
    </div>
  </main>

  <script>
    if (typeof window !== "undefined") {
      const area = document.getElementById("cart-area");

      function loadCart() {
        const cart = JSON.parse(localStorage.getItem("rs_cart") || "[]");
        return cart;
      }

      function saveCart(cart) {
        localStorage.setItem("rs_cart", JSON.stringify(cart));
      }

      function renderCart() {
        const cart = loadCart();
        if (!cart.length) {
          area.innerHTML =
            "<p>Your cart is empty.</p><p><a href='/products/tooth-powder' style='color:#3a5e38;'>Add tooth powder</a></p>";
          return;
        }

        let total = 0;
        let html = '<ul style="list-style:none;padding:0;margin-top:16px;">';

        cart.forEach((item) => {
          const lineTotal = item.price * item.qty;
          total += lineTotal;
          html += `
            <li
              data-id="${item.id}"
              style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;background:#fff;padding:10px 14px;border-radius:8px;gap:16px;"
            >
              <div style="flex:1 1 auto;">
                <strong>${item.name}</strong><br/>
                $${item.price.toFixed(2)}
              </div>
              <div style="display:flex;align-items:center;gap:6px;">
                <button class="qty-btn" data-action="dec" aria-label="Decrease quantity" style="min-width:28px;">−</button>
                <span class="qty-val">${item.qty}</span>
                <button class="qty-btn" data-action="inc" aria-label="Increase quantity" style="min-width:28px;">+</button>
              </div>
              <div style="width:80px;text-align:right;"><strong>$${lineTotal.toFixed(2)}</strong></div>
              <button class="remove-btn" aria-label="Remove item" style="background:none;border:none;color:#b23b3b;font-size:14px;cursor:pointer;">Remove</button>
            </li>
          `;
        });

        html += "</ul>";
        html += `<p style="text-align:right;font-weight:600;font-size:18px;margin-top:12px;">Total: $${total.toFixed(
          2
        )}</p>`;
        html += `<a href="/checkout-start" class="btn" style="margin-top:10px;display:inline-block;">Continue to checkout</a>`;

        area.innerHTML = html;

        // add listeners
        const rows = area.querySelectorAll("li[data-id]");
        rows.forEach((row) => {
          const id = row.getAttribute("data-id");
          const decBtn = row.querySelector('button[data-action="dec"]');
          const incBtn = row.querySelector('button[data-action="inc"]');
          const removeBtn = row.querySelector(".remove-btn");

          incBtn?.addEventListener("click", () => {
            const cart = loadCart();
            const idx = cart.findIndex((p) => p.id === id);
            if (idx > -1) {
              cart[idx].qty += 1;
              saveCart(cart);
              renderCart();
            }
          });

          decBtn?.addEventListener("click", () => {
            const cart = loadCart();
            const idx = cart.findIndex((p) => p.id === id);
            if (idx > -1) {
              if (cart[idx].qty > 1) {
                cart[idx].qty -= 1;
              } else {
                // if qty would go to 0, remove
                cart.splice(idx, 1);
              }
              saveCart(cart);
              renderCart();
            }
          });

          removeBtn?.addEventListener("click", () => {
            const cart = loadCart();
            const filtered = cart.filter((p) => p.id !== id);
            saveCart(filtered);
            renderCart();
          });
        });
      }

      renderCart();
    }
  </script>
</BaseLayout>
