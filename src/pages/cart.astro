---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Cart">
  <h1>Your Cart</h1>
  <p>Items you add will appear here.</p>

  <!-- Stripe placeholder -->
  <button class="btn" type="button" onclick="alert('Stripe checkout – to be wired to backend / Functions');">
    Checkout with Stripe
  </button>

  <!-- Simple PayPal checkout link (safe for static build) -->
  <p style="margin-top:16px;">
    Or pay with PayPal:
    <a
      href="https://www.paypal.com/signin"
      style="color:#3A5E38;text-decoration:underline;"
      >Continue to PayPal</a
    >
  </p>

  <p style="margin-top:24px;font-size:13px;">
    Later we will replace this with real PayPal Smart Buttons using your own client ID.
  </p>
</BaseLayout>
