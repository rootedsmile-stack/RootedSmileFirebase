---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Products | Rooted Smile">
  <main style="padding: 60px 16px; max-width: 1100px; margin: 0 auto;">
    <h1 style="text-align: center; color: #3a5e38; margin-bottom: 40px;">Our Products</h1>

    <div
      style="
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 30px;
        justify-items: center;
      "
    >
      <!-- Tooth Powder card -->
      <div
        style="
          background: #fff;
          border: 1px solid rgba(0,0,0,0.05);
          border-radius: 12px;
          padding: 20px;
          text-align: center;
          width: 100%;
          max-width: 260px;
        "
      >
        <a href="/products/tooth-powder" style="text-decoration: none; color: inherit;">
          <img
            src="/product.png"
            alt="Rooted Smile Tooth Powder"
            style="width: 100%; max-width: 190px; margin: 0 auto 16px; display: block; border-radius: 10px;"
          />
          <h2 style="font-size: 18px; color: #3a5e38; margin: 10px 0 6px;">
            Rooted Smile Tooth Powder
          </h2>
          <p style="font-weight: 600; color: #3a5e38; margin-bottom: 4px;">$38</p>
          <p style="font-size: 13px; color: #5d7a5b;">Earthy, mint-free, night-friendly</p>
        </a>
        <a
          href="/checkout-start"
          class="btn"
          style="
            display: inline-block;
            background: #3a5e38;
            color: #fff;
            padding: 9px 18px;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 500;
            margin-top: 12px;
          "
        >
          Add to cart
        </a>
      </div>

      <!-- Placeholder for future products -->
      <div
        style="
          background: #fff;
          border: 1px dashed rgba(0,0,0,0.07);
          border-radius: 12px;
          padding: 20px;
          text-align: center;
          width: 100%;
          max-width: 260px;
          color: #a8a8a8;
        "
      >
        <p style="margin-top: 50px; margin-bottom: 6px;">More products</p>
        <p style="font-size: 12px;">Coming soon</p>
      </div>
    </div>
  </main>
</BaseLayout>
