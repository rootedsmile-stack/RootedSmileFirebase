---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Products | Rooted Smile" description="Rooted Smile product lineup starting with our mint-free tooth powder.">
  <main style="max-width:1100px;margin:0 auto;padding:24px 16px;">
    <h1>Products</h1>
    <p>We are starting with our signature, earthy, mint-free tooth powder. More variants coming later.</p>

    <div class="feature-grid">
      <article class="feature">
        <img src="/product.png" alt="Rooted Smile Tooth Powder" style="max-width:100%;border-radius:8px;" />
        <h3>Rooted Smile Tooth Powder</h3>
        <p>Gentle, no-mint, good for night brushing. Wipe sink after brushing.</p>
        <a class="btn" href="/products/tooth-powder">View product</a>
      </article>
    </div>
  </main>
</BaseLayout>
