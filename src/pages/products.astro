---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Products | Rooted Smile" description="Rooted Smile product lineup starting with our mint-free tooth powder.">
 <main style="padding: 60px 16px; max-width: 1100px; margin: 0 auto;">
  <h1 style="text-align: center; color: #3a5e38; margin-bottom: 40px;">Our Products</h1>

  <div
    style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 30px;
      justify-items: center;
    "
  >
    <!-- Product Card 1 -->
    <div
      style="
        background: #fff;
        border: 1px solid rgba(0,0,0,0.08);
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        width: 100%;
        max-width: 260px;
      "
    >
      <a href="/products/tooth-powder" style="text-decoration: none; color: inherit;">
        <img
          src="/images/toothpowder.jpg"
          alt="Rooted Smile Tooth Powder"
          style="width: 100%; border-radius: 10px; margin-bottom: 16px;"
        />
        <h2 style="font-size: 18px; color: #3a5e38; margin: 10px 0 6px;">
          Rooted Smile Tooth Powder
        </h2>
        <p style="font-weight: 600; color: #3a5e38;">$38</p>
      </a>
      <a
        href="/cart"
        class="btn"
        style="
          display: inline-block;
          background: #3a5e38;
          color: #fff;
          padding: 10px 20px;
          border-radius: 999px;
          text-decoration: none;
          font-weight: 500;
          margin-top: 10px;
        "
      >
        Add to Cart
      </a>
    </div>

    <!-- Placeholder for future products -->
    <div
      style="
        background: #fff;
        border: 1px dashed rgba(0,0,0,0.1);
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        width: 100%;
        max-width: 260px;
        color: #a8a8a8;
      "
    >
      <p style="margin-top: 60px;">More products coming soon</p>
    </div>
  </div>
</main>
</BaseLayout>
