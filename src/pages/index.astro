---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Rooted Smile | Earthy, mint-free tooth powder"
  description="For people and kids who can’t tolerate minty pastes. Brush, rinse sink, sleep."
>
  <section class="hero">
    <div>
      <h1>An earthy, zing-free tooth powder</h1>
      <p>Mint-free · gentle · good for night brushing · wipe sink after to avoid staining.</p>
      <a class="btn" href="/products/tooth-powder">Shop now</a>
    </div>
    <div class="hero-media">
      <img src="/product.png" alt="Rooted Smile Tooth Powder" />
    </div>
  </section>

  <section class="feature-grid">
    <div class="feature">
      <h3>How to use</h3>
      <p>Use a spoon → palm/plate → dip brush → brush 2 mins → rinse sink.</p>
    </div>
    <div class="feature">
      <h3>When to use</h3>
      <p>Best at night after dinner. Don’t eat afterwards.</p>
    </div>
    <div class="feature">
      <h3>Why earthy?</h3>
      <p>For people who can’t tolerate mint or commercial SLS-heavy pastes.</p>
    </div>
  </section>
</BaseLayout>
