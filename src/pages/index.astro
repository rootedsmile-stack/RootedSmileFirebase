---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Rooted Smile | Earthy Tooth Powder">
  <section class="hero">
    <div>
      <h1>An Earthy, Zing-Free Tooth Powder</h1>
      <p>For sensitive mouths, kids who can’t do mint, and anyone who wants cleaner ingredients.</p>
      <a class="btn" href="/products/tooth-powder/">Shop now</a>
    </div>
    <div class="hero-media">
      <img src="/product.png" alt="Rooted Smile Tooth Powder" />
    </div>
  </section>

  <section class="feature-grid">
    <div class="feature">
      <h3>No mint, no burn</h3>
      <p>Comfort-first formula.</p>
    </div>
    <div class="feature">
      <h3>How to use</h3>
      <p>Use spoon → palm/plate → dip brush → brush 2 mins → rinse sink.</p>
    </div>
    <div class="feature">
      <h3>Best at night</h3>
      <p>Use after dinner and don’t eat after brushing.</p>
    </div>
  </section>
</BaseLayout>
