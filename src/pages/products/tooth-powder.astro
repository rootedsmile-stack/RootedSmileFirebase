---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Rooted Smile Tooth Powder"
  description="Earthy, mint-free tooth powder. Use at night after dinner and wipe sink to avoid natural staining."
>
  <main
    style="max-width:1050px;margin:0 auto;padding:24px 16px;display:grid;grid-template-columns:1fr 1fr;gap:24px;"
  >
    <div>
      <img src="/product.png" alt="Rooted Smile Tooth Powder" style="max-width:100%;border-radius:14px;" />
    </div>
    <div>
      <h1>Rooted Smile Tooth Powder</h1>
      <p>Our original, earthy, mint-free blend — made for people who can’t tolerate strong minty pastes.</p>
      <ul>
        <li>Use a clean spoon — do not dip toothbrush into jar</li>
        <li>Put powder on palm or plate, then dip toothbrush</li>
        <li>Brush 2 minutes, massage gums</li>
        <li>Best at night, don’t eat afterwards</li>
        <li>Wipe or rinse sink to avoid staining</li>
      </ul>
      <p><strong>$38.00</strong></p>
<a class="btn" href="/checkout-start">Add to cart</a>
    </div>
  </main>
</BaseLayout>
