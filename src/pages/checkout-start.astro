---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Checkout | Rooted Smile">
  <main
    style="
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 60px 16px;
    "
  >
    <h1 style="color:#3a5e38; margin-bottom: 30px;">How do you want to checkout?</h1>

    <div style="display: flex; flex-direction: column; gap: 20px; width: 100%; max-width: 350px;">
      <button id="btn-login" class="btn" type="button" style="width:100%;">
        Sign in / Create account
      </button>

      <button id="btn-guest" class="btn" type="button" style="background:#124a3b;width:100%;">
        Checkout as guest
      </button>
    </div>
  </main>

  <script>
    if (typeof window !== "undefined") {
      // ensure the cart has the item at this point
      const existing = JSON.parse(localStorage.getItem("rs_cart") || "[]");
      const item = {
        id: "toothmagic-powder",
        name: "Rooted Smile ToothMagic Powder",
        price: 38,
        qty: 1,
      };

      const idx = existing.findIndex((p) => p.id === item.id);
      if (idx > -1) {
        existing[idx].qty += 1;
      } else {
        existing.push(item);
      }
      localStorage.setItem("rs_cart", JSON.stringify(existing));

      document.getElementById("btn-guest")?.addEventListener("click", () => {
        alert("Guest checkout → Stripe will go here.");
      });

      document.getElementById("btn-login")?.addEventListener("click", () => {
        alert("Firebase login/signup will go here.");
      });
    }
  </script>
</BaseLayout>
