---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Checkout | Rooted Smile">
  <main style="max-width:720px;margin:0 auto;padding:24px 16px;">
    <h1>How do you want to checkout?</h1>
    <p style="margin-bottom:20px;">
      You’re buying: <strong>Rooted Smile Tooth Powder ($38)</strong>
    </p>

    <div style="display:flex;flex-direction:column;gap:14px;max-width:360px;">
      <!-- we will hook this to Firebase next -->
      <button id="btn-login" class="btn" type="button">
        Sign in / Create account
      </button>

      <!-- we will hook this to Stripe next -->
      <button id="btn-guest" class="btn" type="button" style="background:#124a3b;">
        Checkout as guest
      </button>
    </div>

    <p style="font-size:13px;color:#5d7a5b;margin-top:18px;">
      We recommend creating an account if you want order history or subscriptions later.
    </p>
  </main>

  <script>
    if (typeof window !== "undefined") {
      const guest = document.getElementById("btn-guest");
      const login = document.getElementById("btn-login");

      // temporary actions until we wire up Stripe + Firebase
      guest?.addEventListener("click", () => {
        alert("Guest checkout will go to Stripe here.");
      });

      login?.addEventListener("click", () => {
        alert("Login/signup with Firebase goes here.");
      });
    }
  </script>
</BaseLayout>
