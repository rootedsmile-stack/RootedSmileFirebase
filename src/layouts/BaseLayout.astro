---
const {
  title = "Rooted Smile",
  description = "Earthy, mint-free tooth powder for sensitive mouths",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  <link rel="stylesheet" href="/styles.css?v=29" />
    <style>
  /* ✨ Elegant, minimal cart dot — small, balanced, and aligned */
  .cart-dot {
    position: absolute;
    top: -3px;
    right: -2px;
    height: 6px;
    width: 6px;
    border-radius: 50%;
    background-color: #3a5e38;
    border: 1px solid #fff;
    box-shadow: 0 0 1px rgba(0, 0, 0, 0.15);
    display: none;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.4s ease;
  }

  .cart-dot.show {
    display: inline-block;
    opacity: 1;
    transform: scale(1);
  }

  /* subtle hover effect for polish */
  .cart-icon:hover .cart-dot {
    transform: scale(1.1);
  }
</style>
</head>

  <body class="page">
    <!-- Top Bar -->
    <div class="topbar">
      Free shipping over $50 · Use code <strong>ZINGFREE10</strong> for 10% off
    </div>

    <!-- Header Section -->
    <header class="site-header">
      <div class="nav-left">
        <a href="/" class="nav-logo">
          <img src="/logo-placeholder.png?v=24" alt="Rooted Smile Logo" class="logo" />
        </a>
      </div>

      <nav class="main-nav">
        <a href="/">Home</a>
        <a href="/products">Products</a>
        <a href="/contact">Contact</a>
        <a href="/about">About</a>
      </nav>

      <div style="display:flex;align-items:center;gap:14px;">
        <a href="/login" aria-label="Account">
          <img src="/icons/user-icon.svg" alt="User" style="height:26px;width:26px;" />
        </a>
        <!-- ✅ cart link with dot -->
        <a href="/cart" id="cart-icon" class="cart-icon" aria-label="Cart" style="position:relative;">
          <img src="/icons/cart-icon.svg" alt="Cart" style="height:26px;width:26px;" />
          <span id="cart-dot" class="cart-dot"></span>
        </a>
      </div>
    </header>

    <!-- Page Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-links">
        <a href="/contact">Contact Us</a>
        <a href="/shipping-policy">Shipping Policy</a>
        <a href="/return-policy">Return Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/faq">FAQ</a>
        <a href="/about">About Us</a>
      </div>
      <p class="fda">
        These statements have not been evaluated by the Food and Drug Administration. This product is not intended to
        diagnose, treat, cure, or prevent any disease.
      </p>
      <p class="copy">© {new Date().getFullYear()} Rooted Smile</p>
    </footer>

    <!-- Cart Drawer -->
    <div id="cartDrawer" class="cart-drawer">
      <div class="cart-drawer-header">
        <h3>Cart</h3>
        <button id="closeCart" class="cart-close" aria-label="Close cart">&times;</button>
      </div>

      <!-- Free Shipping Bar -->
      <div class="cart-free-ship">
        <p id="freeShipText">Free shipping over $50</p>
        <div class="free-ship-bar">
          <div id="freeShipFill" class="free-ship-fill"></div>
        </div>
      </div>

      <div id="cartItems" class="cart-items">
        <!-- JS will inject items here -->
      </div>

      <div class="cart-drawer-footer">
        <div class="cart-footer-row">
          <span>Subtotal</span>
          <span id="cartSubtotal">$0</span>
        </div>
        <button id="checkoutBtn" class="btn btn-block">Checkout</button>
      </div>
    </div>

    <!-- Overlay -->
    <div id="cartOverlay" class="cart-overlay"></div>

    <!-- ✅ Main Cart Logic -->
    <script src="/cart.js" defer></script>

    <!-- ✅ Cart Dot Update Script -->
    <script>
      if (typeof window !== "undefined") {
        function updateCartDot() {
          const cart = JSON.parse(localStorage.getItem("rs_cart") || "[]");
          const subtotal = cart.reduce(
            (sum, item) => sum + (item.price || 0) * (item.qty || 1),
            0
          );
          const hasItems = cart.some(item => (item.qty || 0) > 0);
          const dot = document.getElementById("cart-dot");

          if (!dot) return;

          if (hasItems) {
            dot.classList.add("show");
            // green below 50, gold above 50
            dot.style.backgroundColor = subtotal >= 50 ? "#b9a76b" : "#3a5e38";
          } else {
            dot.classList.remove("show");
          }
        }

        // run right away
        updateCartDot();

        // when localStorage changes in another tab
        window.addEventListener("storage", updateCartDot);

        // when cart.js dispatches updates
        window.addEventListener("cartUpdated", updateCartDot);
        window.addEventListener("itemAddedToCart", updateCartDot);
      }
    </script>
  </body>
</html>
