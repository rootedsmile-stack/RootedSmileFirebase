---
const {
  title = "Rooted Smile",
  description = "Earthy, mint-free tooth powder for sensitive mouths",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/styles.css?v=21" />
  </head>

  <body class="page">
    <!-- Top Bar -->
    <div class="topbar">
      Free shipping over $50 · Use code <strong>ZINGFREE10</strong> for 10% off
    </div>

    <!-- Header Section -->
    <header class="site-header">
      <div class="nav-left">
        <a href="/" class="nav-logo">
          <img src="/logo-placeholder.png?v=21" alt="Rooted Smile Logo" class="logo" />
        </a>
      </div>
      <nav class="main-nav">
        <a href="/">Home</a>
        <a href="/products">Products</a>
        <a href="/contact">Contact</a>
        <a href="/about">About</a>
      </nav>
      <div style="display:flex;align-items:center;gap:14px;">
        <a href="/login" aria-label="Account">
          <img src="/icons/user-icon.svg" alt="User" style="height:26px;width:26px;" />
        </a>
        <!-- ✅ give it BOTH id and class -->
        <a href="/cart" id="cart-icon" class="cart-icon" aria-label="Cart" style="position:relative;">
          <img src="/icons/cart-icon.svg" alt="Cart" style="height:26px;width:26px;" />
          <span id="cart-count"></span>
        </a>
      </div>
    </header>

    <!-- Page Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-links">
        <a href="/contact">Contact Us</a>
        <a href="/shipping-policy">Shipping Policy</a>
        <a href="/return-policy">Return Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/faq">FAQ</a>
        <a href="/about">About Us</a>
      </div>
      <p class="fda">
        These statements have not been evaluated by the Food and Drug Administration. This product is not intended to
        diagnose, treat, cure, or prevent any disease.
      </p>
      <p class="copy">© {new Date().getFullYear()} Rooted Smile</p>
    </footer>

    <!-- ✅ Cart Drawer -->
    <div id="cartDrawer" class="cart-drawer">
      <div class="cart-drawer-header">
        <h3>Cart</h3>
        <button id="closeCart" class="cart-close" aria-label="Close cart">&times;</button>
      </div>

      <!-- free shipping bar -->
      <div class="cart-free-ship">
        <p id="freeShipText">Free shipping over $50</p>
        <div class="free-ship-bar">
          <div id="freeShipFill" class="free-ship-fill"></div>
        </div>
      </div>

      <div id="cartItems" class="cart-items">
        <!-- JS will inject items here -->
      </div>

      <div class="cart-drawer-footer">
        <div class="cart-footer-row">
          <span>Subtotal</span>
          <span id="cartSubtotal">$0</span>
        </div>
        <button id="checkoutBtn" class="btn btn-block">Checkout</button>
      </div>
    </div>

    <!-- overlay -->
    <div id="cartOverlay" class="cart-overlay"></div>

    <!-- ✅ main cart logic -->
    <script src="/cart.js" defer></script>

    <!-- ✅ little helper to refresh cart count on load -->
    <script>
      if (typeof window !== "undefined") {
        function updateCartCount() {
          const cart = JSON.parse(localStorage.getItem("rs_cart") || "[]");
          const totalQty = cart.reduce((sum, item) => sum + (item.qty || 0), 0);
          const badge = document.getElementById("cart-count");
          if (badge) {
            if (totalQty > 0) {
              badge.style.display = "inline-block";
              badge.textContent = totalQty;
            } else {
              badge.style.display = "none";
            }
          }
        }
        updateCartCount();
        window.addEventListener("storage", updateCartCount);
        window.addEventListener("cartUpdated", updateCartCount);
      }
    </script>
  </body>
</html>
