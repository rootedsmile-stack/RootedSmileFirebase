---
const { title = "Rooted Smile", description = "Earthy, zing-free tooth powder" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="page">
    <div class="topbar">
      Free shipping over $50 · Use code <strong>ZINGFREE10</strong> for 10% off
    </div>

    <header class="site-header">
      <a class="user-link" href="/login.html" aria-label="Login">👤</a>
      <div class="logo-wrap">
        <img src="/logo-placeholder.png" alt="Rooted Smile" class="logo" />
      </div>
      <a class="cart-link" href="/cart.html" aria-label="Cart">🛒</a>
    </header>

    <nav class="main-nav">
      <a href="/">Home</a>
      <a href="/products/">Products</a>
      <a href="/contact.html">Contact Us</a>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-links">
        <a href="/contact.html">Contact Us</a>
        <a href="/shipping-policy.html">Shipping Policy</a>
        <a href="/return-policy.html">Return Policy</a>
        <a href="/terms.html">Terms of Service</a>
        <a href="/faq.html">FAQ</a>
        <a href="/about.html">About Us</a>
      </div>
      <p class="fda">
        These statements have not been evaluated by the Food and Drug Administration. This product is not intended to
        diagnose, treat, cure, or prevent any disease.
      </p>
      <p class="copy">© {new Date().getFullYear()} Rooted Smile.</p>
    </footer>
  </body>
</html>
