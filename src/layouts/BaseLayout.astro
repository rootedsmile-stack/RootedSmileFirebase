---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Rooted Smile | Earthy Tooth Powder">
  <section class="hero">
    <div>
      <h1>An Earthy Tooth Powder</h1>
      <p>Gentle, fluoride-free, zing-free oral care for sensitive mouths.</p>
      <a class="btn" href="/products/tooth-powder">Shop Now</a>
    </div>
    <div style="background:#F5F2EA;border:1px solid rgba(58,94,56,.08);border-radius:16px;min-height:240px;display:flex;align-items:center;justify-content:center;">
      <img src="/product.png" alt="Rooted Smile Tooth Powder" style="max-width:90%;border-radius:12px;" />
    </div>
  </section>

  <section class="feature-grid">
    <div class="feature">
      <h3>Pure &amp; gentle ingredients</h3>
      <p>No harsh foaming agents or artificial flavors.</p>
    </div>
    <div class="feature">
      <h3>Zing-free formula</h3>
      <p>Perfect for sensitive mouths.</p>
    </div>
    <div class="feature">
      <h3>Supports gum comfort</h3>
      <p>Best used at night after dinner, and avoid eating afterward.</p>
    </div>
  </section>
</BaseLayout>
